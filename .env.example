# Copy this file to .env and change the values:  cp .env.example .env
# .env is gitignored; this template is committed so others know which variables exist.

# ---------- PostgreSQL (one server, separate databases per service) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432

# Warehouse database used by ingestion + dbt + Metabase
WAREHOUSE_DB=warehouse
# Least-privilege roles (created by infra/postgres/init.sh)
LOADER_USER=loader
LOADER_PASSWORD=change_me_loader
METABASE_READER_USER=metabase_reader
METABASE_READER_PASSWORD=change_me_reader

# Airflow metadata database (Airflow's own bookkeeping, not our data)
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow_db

# Metabase app database (dashboards, questions, users — not our data)
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=change_me_metabase_db

# ---------- MinIO (S3-compatible raw storage) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=raw

# ---------- Airflow ----------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow
# Run `id -u` on Linux so files written to mounted folders are owned by you (macOS: keep 50000)
AIRFLOW_UID=50000
# Encrypts connection passwords stored in Airflow's DB. Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# Signs tokens between Airflow components. Generate with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=

# ---------- External APIs (needed from Phase 3) ----------
TWELVEDATA_API_KEY=
